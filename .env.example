# COPY to .env. Never commit .env or share the database password.
# Encode special characters in the URI username/password.
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_URL_ENCODED_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/navin_crm?retryWrites=true&w=majority
APP_ORIGIN=http://localhost:3000
PORT=3000
NODE_ENV=development
# Set 1 only when behind exactly one trusted reverse proxy.
TRUST_PROXY=0

# SMTP is required for staff private password setup emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Navin CRM <your-verified-sender@yourcompany.com>
# Optional, for isolated integration tests only:
TEST_MONGODB_URI=
